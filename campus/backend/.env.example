# Runtime
NODE_ENV=development
PORT=8787

# PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/campus_portal?schema=public

# Authentication — use distinct random values of at least 32 characters in production
JWT_ACCESS_SECRET=generate-a-long-random-secret-here
# Envelope-encryption master key for provider/news/e-mail credentials stored in PostgreSQL.
# Production MUST set a dedicated random value of at least 32 characters and keep it outside the database.
PORTAL_SECRETS_ENCRYPTION_KEY=generate-a-dedicated-32-plus-character-secret
JWT_REFRESH_SECRET=generate-a-different-long-random-secret-here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
BCRYPT_SALT_ROUNDS=12

# Initial administrator bootstrap
PORTAL_ADMIN_EMAIL=admin@example.edu
PORTAL_ADMIN_PASSWORD=change-this-in-deployment
PORTAL_ADMIN_NAME=Professor-In-Charge (T&P)

# AI providers (server-side only)
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-latest
AI_PROVIDER_ORDER=groq,gemini

# Server security / rate limits
CORS_ORIGIN=http://localhost:8787,http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_PER_15MIN=20
FACE_MATCH_THRESHOLD=0.48
COOKIE_SAMESITE=lax
VOICE_RATE_LIMIT_PER_MINUTE=20
GATE_REDEEM_RATE_LIMIT_PER_MINUTE=60
PORTAL_AUTH_RATE_LIMIT_PER_15MIN=30

# Password recovery delivery (EmailJS) — server-side only.
# The reset code is e-mailed to the recovery Gmail the student gave when creating the account.
# Either set these here / in Vercel, OR save them from the portal: Admin -> Settings -> Email Delivery
# (that copy is stored in Neon). Env vars win if both exist.
# In EmailJS: Account -> Security -> turn ON "Allow EmailJS API for non-browser applications";
# the PRIVATE key is required for server-side sending. Template: To Email = {{to_email}}, body uses {{passcode}}.
RECOVERY_EMAILJS_SERVICE_ID=
RECOVERY_EMAILJS_TEMPLATE_ID=
RECOVERY_EMAILJS_PUBLIC_KEY=
RECOVERY_EMAILJS_PRIVATE_KEY=
# Set to true to show the exact EmailJS problem in the API response (debugging only; it is always in the server log).
RECOVERY_EXPOSE_DELIVERY_DETAIL=false
# Provider delivery tuning. The backend retries transient EmailJS 429/5xx once and waits up to 20s per attempt.
RECOVERY_EMAIL_MAX_RETRIES=1
RECOVERY_EMAIL_TIMEOUT_MS=20000

# Internal FastAPI AI/ML gateway (server-side only)
# --- AI/ML (FastAPI) service --------------------------------------------------------------------------
# `npm start` starts ../ai-ml-service automatically (first run creates ai-ml-service/.venv and installs it).
# You do NOT have to set anything here: Admin -> Settings -> AI Keys & Services lets the Admin paste the Groq/Gemini keys and
# the service link, stored in the database and applied instantly. Values below are only defaults.
AI_ML_SERVICE_URL=http://127.0.0.1:8000
# Leave the token as it is (or blank). A random token is generated automatically when none is set.
AI_ML_SERVICE_TOKEN=
AI_ML_AUTOSTART=true          # false = don't start the service (use a remote one via the Admin link)
# AI_ML_PYTHON=C:\Python312\python.exe   # only if Python is not found on PATH
AI_ML_PROXY_TIMEOUT_MS=45000
AUTO_MIGRATE=true             # apply database migrations on `npm start`

# Protect internal operational diagnostics (/api/health/runtime, /metrics, /usage, /deep)
OPERATIONS_TOKEN=generate-a-long-random-operations-token

# Leave unset to auto-detect: trusted on Vercel/Render/Railway/Heroku or when
# NODE_ENV=production, untrusted otherwise. Set to 1 or 0 to force it either way
# (e.g. TRUST_PROXY=0 if you run this yourself behind more than one proxy hop).
TRUST_PROXY=

# Production CSP (CSP is enforced automatically in production and report-only in development)

# Optional: NON-pooled connection string used only for `prisma migrate deploy` (Supabase: port 5432, Neon: without -pooler).
# Leave empty if DATABASE_URL is already a direct connection.
DIRECT_URL=

# Secure server-side news integration (never expose this in frontend/localStorage)
GNEWS_API_KEY=

# Server-side presentation image generation (Gemini)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview
AI_IMAGE_TIMEOUT_MS=45000
AI_CACHE_MAX_RESPONSE_CHARS=120000
